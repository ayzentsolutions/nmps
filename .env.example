# Copy to .env.local and replace placeholders. Never commit real credentials.
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR_CLUSTER.mongodb.net/nmps?retryWrites=true&w=majority
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_URL=http://localhost:3000
DEFAULT_SCHOOL_ID=default-school
BOOTSTRAP_SECRET=replace-with-a-random-one-time-secret-at-least-32-characters

# Cloudinary: public media and authenticated private admission documents
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend transactional email: requires a verified sender/domain
RESEND_API_KEY=
EMAIL_FROM=
ADMISSIONS_NOTIFICATION_EMAIL=
ENQUIRY_NOTIFICATION_EMAIL=

# Demo seed must only target a disposable database; production mode is rejected.
SEED_DEMO=false
